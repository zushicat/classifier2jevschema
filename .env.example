# --- Authentication (existing) ---
API_KEY=
USE_API_KEY=false

# --- Source engine (Parallel Constrained Decision Engine) ---
# Base URL of the local classifier engine. From inside the container the Docker
# host is http://host.docker.internal:9321; from the host itself it is
# http://localhost:9321 (only relevant when running the app outside Docker).
SOURCE_API_BASE_URL=http://host.docker.internal:9321
# Request timeout in seconds. The engine serializes requests behind a GPU lock,
# so generous timeouts are normal (default 120).
SOURCE_API_TIMEOUT_SECONDS=120.0

# --- Jev imitation behavior ---
# Model id reported in every response. Leave empty to echo the model string
# the client sent (e.g. "jev-latest"). Example: REPORTED_MODEL_ID=jev-local-rlcd-1.0.0
REPORTED_MODEL_ID=
# Comma-separated allowlist of accepted model ids; empty accepts any model string.
ALLOWED_MODELS=

# --- Usage estimate ---
# Divisor for the chars -> tokens estimate of usage.input_tokens (standard
# chars-per-token heuristic; the engine reports no token counts).
USAGE_TOKEN_DIVISOR=4.0
